{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "The start time",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "description": "The end time",
          "format": "date-time",
          "title": "Until",
          "type": "string"
        },
        "timezone": {
          "$ref": "#/$defs/TimezoneInfo",
          "default": null,
          "title": "Timezone"
        },
        "time_format": {
          "default": "%d %b %Y %H:%M:%S",
          "description": "The time format",
          "ecoscope:advanced": true,
          "title": "Time Format",
          "type": "string"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "weather_er_client": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "description": "Select one of your configured data sources.",
          "title": ""
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to EarthRanger"
    },
    "weather_subject_group_name": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "Weather Station Subject Group",
          "type": "string",
          "default": "TAHMO Stations",
          "description": "The EarthRanger subject group containing the weather stations (e.g. TAHMO Stations), picked from the chosen data source's subject groups.",
          "ecoscope:transform": [
            {
              "transformer": "EarthRangerEnumResolver",
              "transformer_kws": {
                "type": "subject_group_name",
                "depends_on": "properties.weather_er_client.properties.data_source.properties.name"
              }
            }
          ]
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Subject Group Name"
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone",
        "time_format"
      ]
    },
    "ui:order": [
      "workflow_details",
      "time_range",
      "weather_er_client",
      "weather_subject_group_name"
    ]
  },
  "additionalProperties": false
}
